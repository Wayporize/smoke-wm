border.color.highlight.red = 0x0000
border.color.highlight.green = 0xffff
border.color.highlight.blue = 0x0000
border.color.highlight.alpha = 0xffff
border.color.inactive.red = 0x0000
border.color.inactive.green = 0x0000
border.color.inactive.blue = 0xffff
border.color.inactive.alpha = 0xffff
border.color.floating.red = 0xffff
border.color.floating.green = 0x0000
border.color.floating.blue = 0x0000
border.color.floating.alpha = 0xffff
border.color.tiling.red = 0xffff
border.color.tiling.green = 0x0000
border.color.tiling.blue = 0x0000
border.color.tiling.alpha = 0xffff
