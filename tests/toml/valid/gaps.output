tiling.layout = auto
tiling.gaps.inner[0] = 0
tiling.gaps.inner[1] = 1
tiling.gaps.inner[2] = 0
tiling.gaps.inner[3] = 2
tiling.gaps.outer[0] = 0
tiling.gaps.outer[1] = 1
tiling.gaps.outer[2] = 0
